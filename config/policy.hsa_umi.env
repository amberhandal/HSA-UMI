# config/policy.hsa_umi.env - the HSA-UMI runs of the visuomotor diffusion policy.
#
# Same fork and same image as policy.dp.env (the checkpoints must serve from the image they trained
# in), but the HSA-UMI workspace config: task group hsa_umi (the FER + HSA wrist demos), wandb project
# hsa-umi, run names *_hsa_umi*. Select with POLICY=hsa_umi; pick a task variant with a Hydra override:
#   POLICY=hsa_umi DATASET=... ./train_policy.sh                         # task hsa_umi (vision + pose)
#   POLICY=hsa_umi DATASET=... ./train_policy.sh task=hsa_umi_force      # + robot0_ext_wrench
#   POLICY=hsa_umi DATASET=... ./train_policy.sh task=hsa_umi_wrist      # + the HSA wrist streams
#   POLICY=hsa_umi CKPT=... ./serve_policy.sh
# Hyperparameters stay in the fork's Hydra tree; this file only names which workspace yaml to run.

POLICY_DIR=external/polyumi_diffusion_policy
IMAGE=polyumi-dp
CONFIG_NAME=train_diffusion_unet_timm_hsa_umi_workspace
TRAIN_CMD="bash docker/train.sh"
SERVE_CMD="bash docker/serve.sh"
DATASET_MNT=/data/dataset.zarr.zip
