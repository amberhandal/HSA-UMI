<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>hsa_ros2</name>
  <version>0.0.1</version>
  <description>HSA wrist demo collection on the Franka FER: SpaceMouse teleop + recorder, on top of PolyUMI's control stack</description>
  <maintainer email="amberhandal2026@u.northwestern.edu">Amber Handal</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>polyumi_ros2</depend>
  <depend>franka_streaming_impedance_client</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
