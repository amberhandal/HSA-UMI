<?xml version="1.0" encoding="UTF-8"?>
<!--
  Desk test of the whole collection loop with NO hardware: a static transform stands in for the
  arm, fake_camera for the RealSense, and the teleop node runs on its synthetic input.

      ros2 launch hsa_ros2 desk_test.launch.xml output_dir:=/tmp/hsa_desk
      ros2 service call /hsa_recorder/start_episode std_srvs/srv/Trigger "{}"
      ... wait a few seconds ...
      ros2 service call /hsa_recorder/stop_episode  std_srvs/srv/Trigger "{}"
      ros2 service call /hsa_recorder/export_zip    std_srvs/srv/Trigger "{}"
      ros2 run hsa_ros2 export_dataset /tmp/hsa_desk

  Nothing here talks to a robot: the teleop runs with execute:=false.
-->
<launch>
  <arg name="output_dir" default="/tmp/hsa_desk"/>
  <arg name="plan" default="" description="optional per-episode plan CSV"/>
  <arg name="recorder_config" default="$(find-pkg-share hsa_ros2)/config/recorder.yaml"/>
  <arg name="teleop_config" default="$(find-pkg-share hsa_ros2)/config/teleop.yaml"/>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="fake_arm_tf" output="screen"
        args="--x 0.5 --y 0.0 --z 0.3 --roll 3.14159 --pitch 0 --yaw 0 --frame-id fer_link0 --child-frame-id hsa_tcp"/>
  <node pkg="hsa_ros2" exec="fake_camera" name="fake_camera" output="screen"/>
  <node pkg="hsa_ros2" exec="spacemouse_teleop" name="spacemouse_teleop" output="screen">
    <param from="$(var teleop_config)"/>
    <param from="$(find-pkg-share hsa_ros2)/config/robots/fer.yaml"/>
    <param name="input_source" value="fake_sine"/>
    <param name="execute" value="false"/>
  </node>
  <node pkg="hsa_ros2" exec="demo_recorder" name="hsa_recorder" output="screen">
    <param from="$(var recorder_config)"/>
    <param from="$(find-pkg-share hsa_ros2)/config/robots/fer.yaml"/>
    <param name="output_dir" value="$(var output_dir)"/>
    <param name="plan" value="$(var plan)"/>
  </node>
</launch>
