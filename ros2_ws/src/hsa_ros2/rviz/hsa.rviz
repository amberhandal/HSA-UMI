# RViz for HSA-UMI: the arm (real or mock, same topics), the policy's frame, every commanded pose
# and the camera. Fixed frame fer_link0. Opened by launch/rviz.launch.xml.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Commanded chunk (preview)1
      Splitter Ratio: 0.55
    Tree Height: 520
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Arm (robot_description)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF (base, flange, hsa_tcp)
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frame Timeout: 15
      Frames:
        All Enabled: false
        fer_link0:
          Value: true
        fer_link8:
          Value: true
        hsa_tcp:
          Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: Commanded chunk (preview)
      Enabled: true
      Topic:
        Value: /polyumi/target_poses_preview
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.05
      Axes Radius: 0.004
    - Class: rviz_default_plugins/Pose
      Name: Teleop target
      Enabled: true
      Topic:
        Value: /hsa/teleop_target
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.006
    - Class: rviz_default_plugins/Wrench
      Name: External wrench (base frame)
      Enabled: true
      Topic:
        Value: /franka_robot_state_broadcaster/external_wrench_in_base_frame
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Force Color: 204; 51; 51
      Torque Color: 204; 204; 51
      Force Arrow Scale: 0.02
      Torque Arrow Scale: 0.02
      Arrow Width: 0.3
      History Length: 1
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Normalize Range: true
  Global Options:
    Fixed Frame: fer_link0
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 1.9
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0.3
      Pitch: 0.45
      Yaw: 0.9
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Views:
    collapsed: false
